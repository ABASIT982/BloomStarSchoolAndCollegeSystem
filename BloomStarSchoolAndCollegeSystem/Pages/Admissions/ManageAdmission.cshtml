@page
@model BloomStarSchoolAndCollegeSystem.Pages.Admissions.ManageAdmissionsModel
@{
    ViewData["Title"] = "Manage Admissions";
}

<div class="container mx-auto px-6 py-8">
    <h2 class="text-3xl font-bold mb-6 text-blue-900 text-left">Manage Admissions</h2>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div id="successBanner" class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
            @Model.SuccessMessage
        </div>
    }

    <!-- Filters -->
    <form id="filtersForm" method="get" class="flex flex-wrap items-center gap-4 mb-6">
        <select id="filterType" name="StudentType" asp-for="Filter.StudentType" class="border rounded px-3 py-2 w-48">
            <option value="">All Students</option>
            <option value="School" selected="@(Model.Filter.StudentType == "School")">School</option>
            <option value="College" selected="@(Model.Filter.StudentType == "College")">College</option>
        </select>

        <select id="filterGrade" name="Grade" asp-for="Filter.Grade" class="border rounded px-3 py-2 w-48">
            <option value="">All Class/Year</option>
            @foreach (var grade in Model.AvailableGrades)
            {
                <option value="@grade" selected="@(Model.Filter.Grade == grade)">@grade</option>
            }
        </select>

        <select id="filterSection" name="SectionOrDept" asp-for="Filter.SectionOrDept" class="border rounded px-3 py-2 w-60">
            <option value="">All Section/Department</option>
            @foreach (var sec in Model.AvailableSections)
            {
                <option value="@sec" selected="@(Model.Filter.SectionOrDept == sec)">@sec</option>
            }
        </select>

        <input id="filterSearch" name="SearchQuery" asp-for="Filter.SearchQuery" class="border rounded px-3 py-2 w-72" placeholder="Search by name or parent..." value="@Model.Filter.SearchQuery" />

        <button type="button" id="applyBtn" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            Apply Filters
        </button>

        <button type="button" id="resetBtn" class="bg-gray-300 text-gray-800 px-3 py-2 rounded hover:bg-gray-400">
            Reset
        </button>
    </form>

    <!-- Student Data Table -->
    <div class="overflow-x-auto shadow-lg rounded-lg">
        <table id="studentsTable" class="min-w-full bg-white">
            <thead class="bg-blue-600 text-white">
                <tr>
                    <th class="px-4 py-2">Photo</th>
                    <th class="px-4 py-2">Name</th>
                    <th class="px-4 py-2">Parent</th>
                    <th class="px-4 py-2">Phone</th>
                    <th class="px-4 py-2">Address</th>
                    <th class="px-4 py-2">Class/Year</th>
                    <th class="px-4 py-2">Section/Dept</th>
                    <th class="px-4 py-2">Type</th>
                    <th class="px-4 py-2">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FilteredStudents != null && Model.FilteredStudents.Any())
                {
                    foreach (var student in Model.FilteredStudents)
                    {
                        <tr class="border-b hover:bg-gray-50">
                            <td class="px-4 py-2 text-center">
                                @if (!string.IsNullOrEmpty(student.PhotoPath))
                                {
                                    <img src="@student.PhotoPath" class="w-12 h-12 rounded-full mx-auto object-cover" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-full bg-gray-300 flex items-center justify-center text-xs text-gray-600 mx-auto">
                                        No Img
                                    </div>
                                }
                            </td>
                            <td class="px-4 py-2">@student.Name</td>
                            <td class="px-4 py-2">@student.ParentName</td>
                            <td class="px-4 py-2">@student.ParentPhone</td>
                            <td class="px-4 py-2">@student.Address</td>
                            <td class="px-4 py-2">@student.GradeName</td>
                            <td class="px-4 py-2">@student.SectionOrDept</td>
                            <td class="px-4 py-2">@student.StudentType</td>
                            <td class="px-4 py-2 flex gap-2">
                                <!-- Update (open modal) -->
                                <button type="button"
                                        class="bg-yellow-500 text-white px-3 py-1 rounded hover:bg-yellow-600"
                                        onclick="openEditModal(@student.Id, '@student.StudentType')">
                                    Update
                                </button>

                                <!-- Delete (traditional post) -->
                                <form method="post" asp-page-handler="Delete" class="inline-block">
                                    <input type="hidden" name="id" value="@student.Id" />
                                    <input type="hidden" name="type" value="@student.StudentType" />
                                    <button type="submit" class="bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700"
                                            onclick="return confirm('Are you sure you want to delete this student?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-gray-500 py-4">No students found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Update Modal -->
<div id="editModal" class="fixed inset-0 hidden items-center justify-center bg-black bg-opacity-50 z-50">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-2xl">
        <h3 class="text-xl font-bold mb-4">Update Student</h3>

        <form id="editForm" method="post" asp-page-handler="Update" enctype="multipart/form-data">
            <input type="hidden" id="edit-id" name="EditStudent.Id" />
            <input type="hidden" id="edit-type" name="EditStudent.StudentType" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium">Name</label>
                    <input id="edit-name" name="EditStudent.Name" class="border rounded px-3 py-2 w-full" />
                </div>
                <div>
                    <label class="block text-sm font-medium">Parent Name</label>
                    <input id="edit-parent" name="EditStudent.ParentName" class="border rounded px-3 py-2 w-full" />
                </div>
                <div>
                    <label class="block text-sm font-medium">Parent Phone</label>
                    <input id="edit-phone" name="EditStudent.ParentPhone" class="border rounded px-3 py-2 w-full" />
                </div>
                <div>
                    <label class="block text-sm font-medium">Address</label>
                    <input id="edit-address" name="EditStudent.Address" class="border rounded px-3 py-2 w-full" />
                </div>

                <!-- Allow edit of Class/Year and Section/Dept -->
                <div>
                    <label class="block text-sm font-medium">Class / Year</label>
                    <select id="edit-grade" name="EditStudent.GradeName" class="border rounded px-3 py-2 w-full"></select>
                </div>
                <div>
                    <label class="block text-sm font-medium">Section / Department</label>
                    <select id="edit-section" name="EditStudent.SectionOrDept" class="border rounded px-3 py-2 w-full"></select>
                </div>

                <div class="col-span-1 md:col-span-2">
                    <label class="block text-sm font-medium">Upload New Photo (optional)</label>
                    <input type="file" name="UploadedPhoto" class="border rounded px-3 py-2 w-full" />
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-4">
                <button type="button" class="bg-gray-400 text-white px-4 py-2 rounded hover:bg-gray-500" onclick="closeEditModal()">Cancel</button>
                <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // ---------- Helpers ----------
        const debounce = (fn, delay = 350) => {
            let t;
            return (...args) => {
                clearTimeout(t);
                t = setTimeout(() => fn(...args), delay);
            };
        };

        // ---------- Elements ----------
        const filterType = document.getElementById('filterType');
        const filterGrade = document.getElementById('filterGrade');
        const filterSection = document.getElementById('filterSection');
        const filterSearch = document.getElementById('filterSearch');
        const applyBtn = document.getElementById('applyBtn');
        const resetBtn = document.getElementById('resetBtn');
        const studentsTbody = document.querySelector('#studentsTable tbody');
        const successBanner = document.getElementById('successBanner');

        // build query string from current filters
        function buildQueryString() {
            const params = new URLSearchParams();
            if (filterType && filterType.value) params.set('StudentType', filterType.value);
            if (filterGrade && filterGrade.value) params.set('Grade', filterGrade.value);
            if (filterSection && filterSection.value) params.set('SectionOrDept', filterSection.value);
            if (filterSearch && filterSearch.value) params.set('SearchQuery', filterSearch.value);
            return params.toString();
        }

        // fetch page HTML and extract tbody
        async function fetchAndReplaceTable() {
            const qs = buildQueryString();
            const url = window.location.pathname + (qs ? ('?' + qs) : '');
            try {
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const text = await res.text();

                // extract tbody content from returned HTML
                const tbodyMatch = text.match(/<tbody[^>]*>([\s\S]*?)<\/tbody>/i);
                if (tbodyMatch && tbodyMatch.length > 1) {
                    studentsTbody.innerHTML = tbodyMatch[1];
                    if (successBanner) { setTimeout(() => successBanner.style.display = 'none', 3000); }
                } else {
                    console.warn('Could not find tbody in AJAX response. Full page reload fallback.');
                }
            } catch (err) {
                console.error('Error fetching filtered students:', err);
            }
        }

        // fetch options for a given type and update selects
        async function updateFilterOptions(type) {
            const url = window.location.pathname + `?handler=Options&type=${encodeURIComponent(type || '')}`;
            try {
                const res = await fetch(url);
                if (!res.ok) throw new Error('Options request failed');
                const obj = await res.json();
                // obj.grades, obj.sections arrays
                // update filterGrade
                if (filterGrade) {
                    filterGrade.innerHTML = '<option value="">All Class/Year</option>';
                    (obj.grades || []).forEach(g => {
                        const opt = document.createElement('option');
                        opt.value = g;
                        opt.textContent = g;
                        filterGrade.appendChild(opt);
                    });
                }
                // update filterSection
                if (filterSection) {
                    filterSection.innerHTML = '<option value="">All Section/Department</option>';
                    (obj.sections || []).forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s;
                        opt.textContent = s;
                        filterSection.appendChild(opt);
                    });
                }
            } catch (err) {
                console.error('Failed to load options:', err);
            }
        }

        // ---------- Events ----------
        if (filterType) filterType.addEventListener('change', async () => {
            // load new grade/section options for this type, then refresh table
            await updateFilterOptions(filterType.value);
            fetchAndReplaceTable();
        });
        if (filterGrade) filterGrade.addEventListener('change', () => fetchAndReplaceTable());
        if (filterSection) filterSection.addEventListener('change', () => fetchAndReplaceTable());
        if (filterSearch) filterSearch.addEventListener('input', debounce(() => fetchAndReplaceTable(), 300));
        if (applyBtn) applyBtn.addEventListener('click', (e) => { e.preventDefault(); fetchAndReplaceTable(); });
        if (resetBtn) resetBtn.addEventListener('click', async () => {
            if (filterType) filterType.value = '';
            if (filterGrade) { filterGrade.innerHTML = '<option value="">All Class/Year</option>'; }
            if (filterSection) { filterSection.innerHTML = '<option value="">All Section/Department</option>'; }
            if (filterSearch) filterSearch.value = '';
            await updateFilterOptions(''); // load union options
            fetchAndReplaceTable();
        });

        // ---------- Modal control & details fetch ----------
        async function openEditModal(id, type) {
            // set id and type quickly
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-type').value = type;

            try {
                const res = await fetch(window.location.pathname + `?handler=Details&id=${id}&type=${encodeURIComponent(type)}`);
                if (!res.ok) throw new Error('Failed to load details');
                const data = await res.json();

                // fill fields
                document.getElementById('edit-name').value = data.name ?? '';
                document.getElementById('edit-parent').value = data.parentName ?? '';
                document.getElementById('edit-phone').value = data.parentPhone ?? '';
                document.getElementById('edit-address').value = data.address ?? '';

                // populate grade & section selects in modal
                const modalGrade = document.getElementById('edit-grade');
                const modalSection = document.getElementById('edit-section');
                modalGrade.innerHTML = '';
                modalSection.innerHTML = '';

                // add options
                const grades = data.grades || [];
                const sections = data.sections || [];
                grades.forEach(g => {
                    const o = document.createElement('option'); o.value = g; o.textContent = g;
                    if (g === data.grade) o.selected = true;
                    modalGrade.appendChild(o);
                });
                sections.forEach(s => {
                    const o = document.createElement('option'); o.value = s; o.textContent = s;
                    if (s === data.section) o.selected = true;
                    modalSection.appendChild(o);
                });

                // show modal
                const m = document.getElementById('editModal');
                m.classList.remove('hidden'); m.classList.add('flex');
            } catch (err) {
                console.error('Could not fetch student details:', err);
                alert('Could not load student details. Try reloading the page.');
            }
        }
        function closeEditModal() {
            const m = document.getElementById('editModal');
            m.classList.add('hidden'); m.classList.remove('flex');
        }

        // expose for inline onclick
        window.openEditModal = openEditModal;
        window.closeEditModal = closeEditModal;
    </script>
}

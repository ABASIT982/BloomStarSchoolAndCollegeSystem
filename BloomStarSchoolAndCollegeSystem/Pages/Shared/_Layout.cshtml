@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BloomStar</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
</head>
<body class="bg-gray-100 min-h-screen">

    <!-- ===== Top Navbar (royal blue) ===== -->
    <nav class="bg-blue-900 text-white shadow-lg fixed w-full z-50 top-0 left-0">
        <div class="max-w-7xl mx-auto px-4 flex items-center justify-between h-20">
            <!-- Logo + School Name -->
            <a asp-page="/Index" class="flex items-center gap-3">
                <img src="~/images/students/school-logo.png" alt="BloomStar logo"
                     class="w-12 h-12 rounded-full border-2 border-blue-700 object-cover" />
                <div class="leading-tight">
                    <div class="text-xl font-bold text-white">Bloom Star School</div>
                    <div class="text-sm text-blue-300">And College System</div>
                </div>
            </a>

            <!-- Auth Buttons -->
            <div class="flex items-center gap-4">
                @if (!User.Identity?.IsAuthenticated ?? true)
                {
                    <a asp-page="/Admin/Login" class="btn-classic">Login</a>
                    <a asp-page="/Admin/Register" class="btn-classic-outline">Sign Up</a>
                }
                else
                {
                    <form method="post" asp-page="/Admin/Logout">
                        <button type="submit" class="btn-classic">
                            <i class="bi bi-box-arrow-right mr-1"></i> Logout
                        </button>
                    </form>
                }
            </div>
        </div>
    </nav>

    <!-- ===== Page Layout ===== -->
    <div class="pt-24 flex">
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
        {
            <partial name="_AdminSidebar" />
            <main class="ml-0 md:ml-64 flex-1 p-6">
                <div class="max-w-7xl mx-auto px-2">
                    @RenderBody()
                </div>
            </main>
        }
        else
        {
            <main class="flex-1 p-6 w-full">
                <div class="max-w-7xl mx-auto px-2">
                    @RenderBody()
                </div>
            </main>
        }
    </div>

    <footer class="mt-12 py-6 text-center text-sm text-gray-500">
        &copy; @DateTime.Now.Year BloomStar School & College System
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>

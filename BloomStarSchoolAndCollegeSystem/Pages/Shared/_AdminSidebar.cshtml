@* Pages/Shared/_AdminSidebar.cshtml *@
<!-- ✅ Alpine.js for dropdown -->
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

<aside class="admin-sidebar hidden md:block w-64 min-h-screen fixed top-20 left-0 p-4"
       x-data="{ studentOpen: false, teacherOpen: false, admissionOpen: false, feeOpen: false }">
    <nav class="space-y-2">

        <!-- Dashboard -->
        <a asp-page="/Admin/Index"
           class="flex items-center gap-3 px-3 py-2 rounded hover:bg-blue-700">
            <i class="bi bi-speedometer2"></i><span>Dashboard</span>
        </a>

        <!-- Students Dropdown -->
        <button type="button"
                class="w-full flex items-center justify-between gap-3 px-3 py-2 rounded hover:bg-blue-700 text-left"
                @@click="studentOpen = !studentOpen">
            <span class="flex items-center gap-3">
                <i class="bi bi-people-fill"></i><span>Students</span>
            </span>
            <i class="bi"
               :class="studentOpen ? 'bi-chevron-down' : 'bi-chevron-right'"></i>
        </button>

        <div x-show="studentOpen" x-collapse
             class="ml-6 mt-1 border-l border-blue-700 pl-3 space-y-1 text-sm text-blue-100">
            <a asp-page="/Students/School/Index" class="block px-3 py-1.5 rounded hover:bg-blue-600">School Students</a>
            <a asp-page="/Students/College/Index" class="block px-3 py-1.5 rounded hover:bg-blue-600">College Students</a>
        </div>

        <!-- Teachers Dropdown -->
        <button type="button"
                class="w-full flex items-center justify-between gap-3 px-3 py-2 rounded hover:bg-blue-700 text-left"
                @@click="teacherOpen = !teacherOpen">
            <span class="flex items-center gap-3">
                <i class="bi bi-person-badge"></i><span>Teachers</span>
            </span>
            <i class="bi" :class="teacherOpen ? 'bi-chevron-down' : 'bi-chevron-right'"></i>
        </button>

        <div x-show="teacherOpen" x-collapse
             class="ml-6 mt-1 border-l border-blue-700 pl-3 space-y-1 text-sm text-blue-100">
            <a asp-page="/Teachers/AddTeacher" class="block px-3 py-1.5 rounded hover:bg-blue-600">Add New Teacher</a>
            <a asp-page="/Teachers/AllTeacher" class="block px-3 py-1.5 rounded hover:bg-blue-600">All Teachers</a>
            <a asp-page="/Teachers/TeacherSalaries" class="block px-3 py-1.5 rounded hover:bg-blue-600">Teacher Salaries</a>
            <a asp-page="/Teachers/PaySalaries" class="block px-3 py-1.5 rounded hover:bg-blue-600">Pay Salary</a>
        </div>

        <!-- ✅ Fee Dropdown (New Section) -->
        <button type="button"
                class="w-full flex items-center justify-between gap-3 px-3 py-2 rounded hover:bg-blue-700 text-left"
                @@click="feeOpen = !feeOpen">
            <span class="flex items-center gap-3">
                <i class="bi bi-cash-stack"></i><span>Fee</span>
            </span>
            <i class="bi" :class="feeOpen ? 'bi-chevron-down' : 'bi-chevron-right'"></i>
        </button>

        <div x-show="feeOpen" x-collapse
             class="ml-6 mt-1 border-l border-blue-700 pl-3 space-y-1 text-sm text-blue-100">
            <a asp-page="/Fees/FeeDetails" class="block px-3 py-1.5 rounded hover:bg-blue-600">Fee Details</a>
            <a asp-page="/Fees/AddFee" class="block px-3 py-1.5 rounded hover:bg-blue-600">Pay Fee</a>
            <a asp-page="/Fee/FeeReports" class="block px-3 py-1.5 rounded hover:bg-blue-600">Fee Reports</a>
        </div>

        <!-- Admissions Dropdown -->
        <button type="button"
                class="w-full flex items-center justify-between gap-3 px-3 py-2 rounded hover:bg-blue-700 text-left"
                @@click="admissionOpen = !admissionOpen">
            <span class="flex items-center gap-3">
                <i class="bi bi-journal-text"></i><span>Admissions</span>
            </span>
            <i class="bi" :class="admissionOpen ? 'bi-chevron-down' : 'bi-chevron-right'"></i>
        </button>

        <div x-show="admissionOpen" x-collapse
             class="ml-6 mt-1 border-l border-blue-700 pl-3 space-y-1 text-sm text-blue-100">
            <a asp-page="/Admissions/NewAdmission" class="block px-3 py-1.5 rounded hover:bg-blue-600">New Admission</a>
            <a asp-page="/Admissions/ManageAdmission" class="block px-3 py-1.5 rounded hover:bg-blue-600">Manage Admission</a>
        </div>

        <!-- Other main items -->
        <a asp-page="/Admin/Finance" class="flex items-center gap-3 px-3 py-2 rounded hover:bg-blue-700">
            <i class="bi bi-cash-coin"></i><span>Finance</span>
        </a>

        <a asp-page="/Admin/Reports" class="flex items-center gap-3 px-3 py-2 rounded hover:bg-blue-700">
            <i class="bi bi-bar-chart-line"></i><span>Reports</span>
        </a>

    </nav>
</aside>

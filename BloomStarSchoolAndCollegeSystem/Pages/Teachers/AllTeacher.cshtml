@page
@model BloomStarSchoolAndCollegeSystem.Pages.Teachers.AllTeachersModel
@{
    ViewData["Title"] = "All Teachers";
}

<div class="flex flex-col items-center py-10 bg-gray-100 min-h-screen">
    <h2 class="text-3xl font-bold mb-6 text-blue-900">All Teachers</h2>

    <div class="overflow-x-auto w-full max-w-6xl bg-white shadow-2xl rounded-2xl p-6">
        <table class="min-w-full table-auto border-collapse">
            <thead>
                <tr class="bg-blue-600 text-white text-left">
                    <th class="px-4 py-2 rounded-tl-xl">Photo</th>
                    <th class="px-4 py-2">Name</th>
                    <th class="px-4 py-2">Subject</th>
                    <th class="px-4 py-2">Qualification</th>
                    <th class="px-4 py-2">Address</th>
                    <th class="px-4 py-2">Contact</th>
                    <th class="px-4 py-2">Gender</th>
                    <th class="px-4 py-2">Net Salary</th>
                    <th class="px-4 py-2">Total Paid</th>
                    <th class="px-4 py-2">Remaining</th>
                    <th class="px-4 py-2">Status</th>
                    <th class="px-4 py-2 rounded-tr-xl">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Teachers)
                {
                    var remaining = t.NetSalary - t.TotalPaid;
                    <tr class="border-b hover:bg-gray-100 transition">
                        <td class="px-4 py-2">
                            @if (!string.IsNullOrEmpty(t.PhotoPath))
                            {
                                <img src="@t.PhotoPath" alt="Photo" class="w-16 h-16 object-cover rounded-full border" />
                            }
                            else
                            {
                                <div class="w-16 h-16 bg-gray-200 rounded-full flex items-center justify-center text-gray-500">N/A</div>
                            }
                        </td>
                        <td class="px-4 py-2">@t.Name</td>
                        <td class="px-4 py-2">@t.Subject</td>
                        <td class="px-4 py-2">@t.Qualification</td>
                        <td class="px-4 py-2">@t.Address</td>
                        <td class="px-4 py-2">@t.Contact</td>
                        <td class="px-4 py-2">@t.Gender</td>
                        <td class="px-4 py-2">@t.NetSalary</td>
                        <td class="px-4 py-2">@t.TotalPaid</td>
                        <td class="px-4 py-2">@remaining</td>
                        <td class="px-4 py-2">@t.SalaryStatus</td>
                        <td class="px-4 py-2">
                            @if (remaining > 0)
                            {
                                <a asp-page="/Teachers/PaySalaries" asp-route-id="@t.Id" class="bg-green-600 text-white px-3 py-1 rounded-lg hover:bg-green-700 transition">Pay Salary</a>
                            }
                            else
                            {
                                <span class="text-gray-500">Paid</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

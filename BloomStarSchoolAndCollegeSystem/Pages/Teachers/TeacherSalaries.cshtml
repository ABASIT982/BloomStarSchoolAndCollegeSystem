@page
@model BloomStarSchoolAndCollegeSystem.Pages.Teachers.TeacherSalariesModel
@{
    ViewData["Title"] = "Teacher Salaries";
}

<h2 class="text-2xl font-bold mb-4">Teacher Salaries</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Net Salary</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Teachers)
        {
            <tr>
                <td>@t.Name</td>
                <td>@t.NetSalary</td>
                <td>@t.SalaryStatus</td>
            </tr>
        }
    </tbody>
</table>

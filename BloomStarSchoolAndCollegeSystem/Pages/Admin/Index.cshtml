@page
@model BloomStarSchoolAndCollegeSystem.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 class="text-3xl font-bold mb-6"> Admin Dashboard</h1>

<div class="dashboard-grid">
    <div class="dash-card bg-blue">
        <i class="bi bi-people-fill dash-icon"></i>
        <div class="card-title">School Students</div>
        <div class="card-value">@Model.SchoolStudentCount</div>
    </div>

    <div class="dash-card bg-green">
        <i class="bi bi-people dash-icon"></i>
        <div class="card-title">College Students</div>
        <div class="card-value">@Model.CollegeStudentCount</div>
    </div>

    <div class="dash-card bg-orange">
        <i class="bi bi-cash-stack dash-icon"></i>
        <div class="card-title">Total Fees Collected</div>
        <div class="card-value">₨ @Model.TotalFeesCollected</div>
    </div>

    <div class="dash-card bg-purple">
        <i class="bi bi-award dash-icon"></i>
        <div class="card-title">Scholarships</div>
        <div class="card-value">@Model.ScholarshipsCount</div>
    </div>

    <div class="dash-card bg-pink">
        <i class="bi bi-card-list dash-icon"></i>
        <div class="card-title">Coming Soon</div>
        <div class="card-value">--</div>
    </div>
</div>

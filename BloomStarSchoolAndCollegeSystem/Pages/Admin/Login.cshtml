@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-card">
    <h2 class="text-2xl font-bold mb-6 text-center">Login</h2>

    <form method="post">
        <div>
            <label asp-for="Input.Email" class="block text-sm font-medium mb-1">Email</label>
            <input asp-for="Input.Email" placeholder="Enter your email" />
            <span asp-validation-for="Input.Email" class="text-red-400 text-sm"></span>
        </div>

        <div>
            <label asp-for="Input.Password" class="block text-sm font-medium mb-1">Password</label>
            <input asp-for="Input.Password" type="password" placeholder="Enter your password" />
            <span asp-validation-for="Input.Password" class="text-red-400 text-sm"></span>
        </div>

        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center">
                <input asp-for="Input.RememberMe" class="mr-2" />
                <label asp-for="Input.RememberMe" class="text-sm">Remember me</label>
            </div>
        </div>

        <button type="submit" class="btn-classic w-full">Login</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

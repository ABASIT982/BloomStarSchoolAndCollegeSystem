@page
@model BloomStarSchoolAndCollegeSystem.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Admin Login";
}

<div class="auth-card">
    <h2>Admin Login</h2>
    <form method="post">
        <div>
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" placeholder="Enter your email" />
            <span asp-validation-for="Input.Email" class="text-red-400"></span>
        </div>

        <div>
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" type="password" placeholder="Enter your password" />
            <span asp-validation-for="Input.Password" class="text-red-400"></span>
        </div>

        <div>
            <input asp-for="Input.RememberMe" /> <label asp-for="Input.RememberMe">Remember me</label>
        </div>

        <button type="submit" class="btn-classic w-full text-lg">Login</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
